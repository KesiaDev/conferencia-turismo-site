generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Authorization {
  id        String   @id @default(cuid())
  name      String
  document  String
  email     String
  summary   String
  accepted  Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@unique([email, summary])
}

model LiveStream {
  id         String   @id @default(cuid())
  title      String
  youtubeUrl String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Photo {
  id          String      @id @default(cuid())
  url         String
  publicId    String
  nome        String?
  descricao   String?
  status      PhotoStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  likes       Like[]
  comments    Comment[]
}

model Like {
  id        String   @id @default(cuid())
  visitorId String
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([visitorId, photoId])
}

model Comment {
  id        String   @id @default(cuid())
  authorName String
  content   String
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}
