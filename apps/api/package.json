{
  "name": "@conferencia/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "prisma generate && tsc",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "start": "prisma migrate deploy && npx tsx prisma/seed.ts && node dist/index.js",
    "lint": "eslint src --ext .ts",
    "postinstall": "node -e \"if (!process.env.PUPPETEER_SKIP_CHROMIUM_DOWNLOAD && !process.env.RAILWAY_ENVIRONMENT) { try { require('child_process').execSync('npx puppeteer browsers install chrome', {stdio: 'inherit'}); } catch(e) { console.log('Skipping Puppeteer Chrome install (Chromium will be used)'); } }\""
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cloudinary": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "tsx": "^4.7.0",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "nodemailer": "^7.0.6",
    "puppeteer": "^24.23.0",
    "prisma": "^5.22.0",
    "resend": "^4.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.2",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
